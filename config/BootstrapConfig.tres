[gd_resource type="Resource" script_class="BootstrapConfig" load_steps=36 format=3]

[ext_resource type="Script" path="res://scripts/platform/BootstrapConfig.gd" id="1_config"]
[ext_resource type="Script" path="res://scripts/platform/ServiceDefinition.gd" id="2_def"]
[ext_resource type="Script" path="res://scripts/platform/ResourceDefinition.gd" id="3_resdef"]

; ─────────────────────────────────────────────
; GLOBAL-SERVICES — app-lifetime, kein Charakter-State (ADR-009)
; ─────────────────────────────────────────────

