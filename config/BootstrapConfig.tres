[sub_resource type="Resource" id="Resource_settings_service"]
script = ExtResource("2_def")
service_name = "settings_service"
path = "res://scripts/persistence/SettingsService.gd"
required_deps = Array[String]([])

; ADR-031: Rollenbasiertes Permission-System. App-Scope, da Rollen account-weit
; gelten, nicht pro Welt/Charakter (siehe ADR dortige Begründung).
[sub_resource type="Resource" id="Resource_permission_service"]
script = ExtResource("2_def")
service_name = "permission_service"
path = "res://scripts/platform/PermissionService.gd"
required_deps = Array[String]([])

; ─────────────────────────────────────────────
; SESSION-SERVICES — charakter-lifetime, werden bei Charakter-Wechsel
; neu gebootet (ADR-009). Können auf Global-Services als Deps verweisen.
; ─────────────────────────────────────────────

[sub_resource type="Resource" id="Resource_playerstates"]
script = ExtResource("2_def")
service_name = "playerstates"
path = "res://scripts/entities/player/PlayerStateService.gd"
required_deps = Array[String]([])
