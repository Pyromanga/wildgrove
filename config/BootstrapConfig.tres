[sub_resource type="Resource" id="Resource_stat_modifiers"]
script = ExtResource("2_def")
service_name = "stat_modifiers"
path = "res://scripts/economy/equipment/StatModifierService.gd"
required_deps = Array[String]([])

; ADR-030: Zonen-System.
[sub_resource type="Resource" id="Resource_zone_service"]
script = ExtResource("2_def")
service_name = "zone_service"
path = "res://scripts/world/zones/ZoneService.gd"
required_deps = Array[String]([])
optional_deps = Array[String](["event_bus"])

[sub_resource type="Resource" id="Resource_combat"]
script = ExtResource("2_def")
service_name = "combat"
path = "res://scripts/entities/combat/CombatSystem.gd"
required_deps = Array[String](["event_bus"])
optional_deps = Array[String](["equipment", "pvp", "skill_system", "stat_modifiers", "ticker"])

[sub_resource type="Resource" id="Resource_equipment"]
script = ExtResource("2_def")
service_name = "equipment"
path = "res://scripts/economy/equipment/EquipmentService.gd"
required_deps = Array[String](["savesystem"])
optional_deps = Array[String](["data", "inventory", "stat_modifiers"])

[sub_resource type="Resource" id="Resource_skill_system"]
script = ExtResource("2_def")
service_name = "skill_system"
path = "res://scripts/progression/skills/SkillSystem.gd"
required_deps = Array[String](["data", "event_bus", "savesystem"])
