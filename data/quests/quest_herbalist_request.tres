[resource]
script = ExtResource("1_ques")
id = "quest_herbalist_request"
title = "Sennas Sammelauftrag"
description = "Die Kräuterkundige Senna braucht frische Zutaten für ihre Tinkturen. Sammle wilde Pilze und Farnfasern für sie."
category = "side"
objectives = [SubResource("obj_collect_mushroom"), SubResource("obj_collect_fern_fiber")]
prerequisites = []
auto_start = false
repeatable = false
reward = SubResource("reward")
