[gd_resource type="Resource" script_class="QuestDefinition" load_steps=7 format=3]

[ext_resource type="Script" path="res://scripts/progression/quests/QuestDefinition.gd" id="1_ques"]
[ext_resource type="Script" path="res://scripts/progression/quests/QuestReward.gd" id="2_ques"]
[ext_resource type="Script" path="res://scripts/progression/quests/QuestObjective.gd" id="3_ques"]

[sub_resource type="Resource" id="obj_collect_cactus_fiber"]
script = ExtResource("3_ques")
id = "obj_collect_cactus_fiber"
label = "Sammle 2 Kaktusfasern"
type = 0
target_id = "cactus_fiber"
required = 2
optional = false

[sub_resource type="Resource" id="obj_talk_senna_again"]
script = ExtResource("3_ques")
id = "obj_talk_senna_again"
label = "Sprich erneut mit Senna"
type = 4
target_id = "senna_herbalist"
required = 1
optional = false

[sub_resource type="Resource" id="reward"]
script = ExtResource("2_ques")
xp_rewards = {"foraging": 25}
item_rewards = {}
unlock_quests = []
custom_signals = []
stat_modifiers = {"gathering_yield_foraging": 0.1}

[resource]
script = ExtResource("1_ques")
id = "quest_herbalist_secret"
title = "Das geheime Rezept"
description = "Senna vertraut dir jetzt genug, um dir von einem seltenen Rezept zu erzählen. Sie braucht dafür widerstandsfähige Kaktusfasern — und noch einmal dein Ohr."
category = "side"
objectives = [SubResource("obj_collect_cactus_fiber"), SubResource("obj_talk_senna_again")]
prerequisites = ["quest_herbalist_request"]
auto_start = false
repeatable = false
reward = SubResource("reward")
