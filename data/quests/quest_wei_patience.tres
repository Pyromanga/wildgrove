[resource]
script = ExtResource("1_ques")
id = "quest_wei_patience"
title = "Geduld vor Tempo"
description = "Kampfmeisterin Wei zaehlt keine Kills. Sie will sehen, dass du dich im Kampf wirklich weiterentwickelst, nicht nur ueberlebst."
