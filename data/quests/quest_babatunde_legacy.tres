[resource]
script = ExtResource("1_ques")
id = "quest_babatunde_legacy"
title = "Weitergegebenes Wissen"
description = "Babatunde merkt beschaemt, dass die Fehde seit Generationen vorbei ist. Zufrieden gibt er dir statt Beute etwas Wertvolleres weiter: Wissen ueber den Wald."
category = "side"
objectives = [SubResource("obj_reach_forestry_2"), SubResource("obj_talk_babatunde_again")]
prerequisites = ["quest_babatunde_tale"]
auto_start = false
repeatable = false
reward = SubResource("reward")
