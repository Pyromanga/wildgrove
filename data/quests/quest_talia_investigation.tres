[resource]
script = ExtResource("1_ques")
id = "quest_talia_investigation"
title = "Der Dieb im Pelz"
description = "Aus Miras Lager verschwinden nachts glaenzende Sachen. Waechterin Talia braucht Hilfe, der Spur zu folgen -- bis zum eigentlichen Uebeltaeter."
category = "side"
objectives = [SubResource("obj_talk_mira_clue"), SubResource("obj_track_forestry_3"), SubResource("obj_catch_fox"), SubResource("obj_talk_talia_report")]
prerequisites = []
auto_start = false
repeatable = false
reward = SubResource("reward")
