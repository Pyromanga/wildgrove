[resource]
script = ExtResource("1_ques")
id = "quest_babatunde_tale"
title = "Die Geschichte, die dir keiner glaubt"
description = "Der Ahnengeist Babatunde erzaehlt von einer alten Fehde und bittet dich, die Geschichte weiterzutragen. Ahnenwissen lebt nur, wenn es erzaehlt wird."
category = "side"
objectives = [SubResource("obj_talk_erik_tale"), SubResource("obj_talk_mira_tale")]
prerequisites = []
auto_start = false
repeatable = false
reward = SubResource("reward")
