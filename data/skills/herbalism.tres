[ext_resource type="Script" path="res://scripts/progression/skills/SkillDefinition.gd" id="1_skil"]

[resource]
script = ExtResource("1_skil")
id = "herbalism"
display_name = "Kräuterkunde"
description = "Kräuter am Wegrand erkennen und ernten – der Hain flüstert dir ihre alten Namen. Wusstest du? Aspirin trägt den Namen des Mädesüß: A für Acetyl, spir für Spiraea (Salicylate). Iss nie Pflanzen, die du nicht sicher kennst."
xp_to_level_up = Array[int]([100, 220, 400, 650, 1000, 1450, 2000])
xp_scaling_factor = 1.2
max_level = 50
