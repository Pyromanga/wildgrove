[ext_resource type="Script" path="res://scripts/progression/skills/SkillDefinition.gd" id="1_skil"]

[resource]
script = ExtResource("1_skil")
id = "entomology"
display_name = "Insektenkunde"
description = "Nester von Ameisen, Termiten, Wespen und Hornissen erkunden. Wusstest du? Wespen kauen Holz zu Brei und bauen daraus Papier – das brachte Réaumur um 1720 auf die Idee, Papier aus Holz zu machen."
xp_to_level_up = Array[int]([100, 220, 400, 650, 1000, 1450, 2000])
xp_scaling_factor = 1.2
max_level = 50
