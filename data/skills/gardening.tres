script = ExtResource("1_skil")
id = "gardening"
display_name = "Gartenkunde"
description = "Blumen säen, pflegen und pflücken, bis der Hain in allen Farben leuchtet. Wusstest du? Nur junge Sonnenblumen folgen der Sonne, erwachsene blicken nach Osten (Heliotropismus)."
