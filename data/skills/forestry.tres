[ext_resource type="Script" path="res://scripts/progression/skills/SkillDefinition.gd" id="1_skill"]

[resource]
script = ExtResource("1_skill")
id = "forestry"
display_name = "Försterei"
description = "Setzlinge pflanzen und großziehen, bis aus dem Keimling ein Baum wird. Wusstest du? Eine Eiche kann über tausend Jahre alt werden – wer sie pflanzt, pflanzt oft für Enkel statt für sich selbst."
xp_to_level_up = Array[int]([100, 250, 500, 900, 1400, 2000, 2800, 3800, 5000, 6500])
xp_scaling_factor = 1.5
max_level = 99
