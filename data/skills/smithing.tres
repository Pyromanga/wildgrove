[ext_resource type="Script" path="res://scripts/progression/skills/SkillDefinition.gd" id="1_skil"]

[resource]
script = ExtResource("1_skil")
id = "smithing"
display_name = "Schmelzen & Schmieden"
description = "Erz im Hochofen schmelzen und auf dem Amboss Waffen und Rüstung schmieden, bis die Glut im Takt des Hains summt. Wusstest du? Je heißer Eisen glüht, desto heller und weißer wird sein Licht – daran erkennen Schmiede seine Temperatur (Glühfarben)."
xp_to_level_up = Array[int]([100, 220, 400, 650, 1000, 1450, 2000])
xp_scaling_factor = 1.2
max_level = 50
