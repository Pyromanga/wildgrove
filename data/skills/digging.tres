[ext_resource type="Script" path="res://scripts/progression/skills/SkillDefinition.gd" id="1_skill"]

[resource]
script = ExtResource("1_skill")
id = "digging"
display_name = "Graben"
description = "Die Erde mit der Schaufel umgraben und formen – jeder Spatenstich weckt ein leises Grün. Wusstest du? In ungestörtem Boden liegt Älteres unten, Jüngeres oben; darum dokumentieren Archäologen jeden Schnitt (Stratigraphie)."
xp_to_level_up = Array[int]([100, 250, 500, 900, 1400, 2000, 2800, 3800, 5000, 6500])
xp_scaling_factor = 1.5
max_level = 99
