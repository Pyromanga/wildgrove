[ext_resource type="Script" path="res://scripts/progression/skills/SkillDefinition.gd" id="1_skill"]

[resource]
script = ExtResource("1_skill")
id = "pickpocketing"
display_name = "Diebstahl"
description = "Die Kunst, anderen Spielern unbemerkt Gold und Gegenstände zu entwenden. Wusstest du? Wer etwas Auffälliges anstarrt, übersieht anderes (Unaufmerksamkeitsblindheit) – Trickdiebe nutzen das. Schütze dich: Wertsachen in verschlossene Innentaschen."
xp_to_level_up = Array[int]([1000])
xp_scaling_factor = 1.0
max_level = -1
