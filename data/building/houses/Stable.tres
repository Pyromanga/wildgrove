script = ExtResource("1_house")
id = "stable"
display_name = "Stall"
description = "4×2 Felder Holzstall für Pferd und Esel: Futtertrog und Wassertrog an der Rückwand, Trennzaun zwischen den Boxen, Heuballen und Sack in der Front, Eingang an der Ostseite. Davor ein Handkarren und eine Laterne."
