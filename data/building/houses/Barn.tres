[gd_resource type="Resource" script_class="HouseTemplateDefinition" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/world/building/HouseTemplateDefinition.gd" id="1_house"]

[resource]
script = ExtResource("1_house")
id = "barn"
display_name = "Scheune"
description = "5×3 Felder große Holzscheune mit Bogentor nach Süden und zwei Fenstern: Heuballen, Kisten, Säcke, Fässer, Karren und Holzstapel als Lager, Vogelscheuche im Winterquartier. Das Bogentor-Feld bleibt frei."
