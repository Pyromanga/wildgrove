[resource]
script = ExtResource("1_house")
id = "village_cemetery"
display_name = "Dorffriedhof"
description = "4×4 Felder, niedrige Steinmauer mit Friedhofstor an der Front. Acht Gräber (Grabsteine, -kreuze, -platten) in zwei Reihen, Wegkreuz mittig als Gedenkstätte. Kein Boden — die Gräber stehen frei auf dem Gelände."
