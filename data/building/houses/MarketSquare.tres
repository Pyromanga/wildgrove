[gd_resource type="Resource" script_class="HouseTemplateDefinition" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/world/building/HouseTemplateDefinition.gd" id="1_house"]

[resource]
script = ExtResource("1_house")
id = "market_square"
display_name = "Marktplatz"
description = "5×3 Felder Steinpflaster. Im Norden vier Marktstände (rot/blau) um einen Wegweiser, in der Mitte ein Brunnen, im Süden zwei Stände mit Fässern und eine Laterne. Keine Mauern — Stände zum Platz hin geöffnet. Mitte des Platzes anvisieren und dort stehen."
