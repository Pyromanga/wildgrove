[gd_resource type="Resource" script_class="HouseTemplateDefinition" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/world/building/HouseTemplateDefinition.gd" id="1_house"]

[resource]
script = ExtResource("1_house")
id = "craft_quarter"
display_name = "Handwerkerviertel"
description = "6×5 Felder: kleine Schmiede mit Hochofen (Amboss-Platz frei zum Nachrüsten), Bäckerei mit Tür zur gepflasterten Straße und Zimmerei gegenüber, dazu zwei Marktstände, Brunnen, Wegweiser, Laternen und Fässer. Größte Struktur — Mitte des Viertels anvisieren und dort stehen, sonst ist ein Teil außer Reichweite."
