[resource]
script = ExtResource("1_house")
id = "city_gate_grand"
display_name = "Großes Stadttor"
description = "14 m breite Torfront mit DREI Rundbogen-Toren nebeneinander (Holzflügel offen), zwei Rundtürmen, Zinnenbrüstung und durchgehendem Wehrgang über den Toren, zwei Treppen auf die Mauerkrone, Pflaster durch die Tore. Mitte anvisieren und dort stehen."
