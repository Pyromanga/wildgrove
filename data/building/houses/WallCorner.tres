script = ExtResource("1_house")
id = "wall_corner"
display_name = "Mauereck mit Eckturm"
description = "Rundturm mit Zinnenmauer-Armen nach Osten und Süden (je fünf Felder) und einer Fahne. Baustein für Stadt- und Burgmauern: an den Armen weitere Mauerstücke, Torbögen oder Türme ansetzen. Mitte der Arme anvisieren."
