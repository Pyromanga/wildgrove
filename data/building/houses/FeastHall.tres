[gd_resource type="Resource" script_class="HouseTemplateDefinition" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/world/building/HouseTemplateDefinition.gd" id="1_house"]

[resource]
script = ExtResource("1_house")
id = "feast_hall"
display_name = "Festhalle"
description = "7×5 Felder lange Holzhalle: nur die beiden Langseiten sind Wand (mit Bogenfenstern), die Giebelseiten bleiben offen zwischen Holzsäulen. Ein einziges Dach überspannt die ganze Halle (Überhang bis zwei Zellen). Vier Tische mit Hockern, Feuerstelle in der Mitte, Fahnen und Fässer. Mitte anvisieren und dort stehen."
