[resource]
script = ExtResource("1_house")
id = "small_castle"
display_name = "Kleine Burg"
description = "4×4 Felder Burghof, hohe Steinmauer mit vier Rundtürmen an den Ecken. Der Torturm an der Front ersetzt ein Mauerstück (begehbare Durchfahrt), im Hof stehen ein Brunnen und ein Katapult. Kein Boden — der Hof liegt frei auf dem Gelände."
