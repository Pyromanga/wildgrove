[gd_resource type="Resource" script_class="HouseTemplateDefinition" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/world/building/HouseTemplateDefinition.gd" id="1_house"]

[resource]
script = ExtResource("1_house")
id = "fortress_yard"
display_name = "Wehrhof"
description = "6×5 Felder Festungshof: hohe Zinnenmauer, vier Rundtürme an den Ecken, Torturm an der Südfront (begehbare Durchfahrt), im Hof Brunnen, Waffenständer, Holzstapel, Fass, Handkarren, Feuerstelle, Bank und Fahnen, gepflasterter Weg vom Tor. Größte Struktur des Wehrbaus — Mitte des Hofes anvisieren und dort stehen."
pieces = Array[Dictionary]([
