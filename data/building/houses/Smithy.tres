[gd_resource type="Resource" script_class="HouseTemplateDefinition" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/world/building/HouseTemplateDefinition.gd" id="1_house"]

[resource]
script = ExtResource("1_house")
id = "smithy"
display_name = "Schmiede"
description = "3×2 Felder, Steinmauern und Steindach, eine Tür, Hochofen hinten links. Der Amboss (hinten rechts, Feld frei gelassen) braucht Eisenbarren und lässt sich erst nachrüsten: Hochofen bauen, Eisen schmelzen, dann den Amboss setzen."
