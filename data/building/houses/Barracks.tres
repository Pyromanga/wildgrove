[gd_resource type="Resource" script_class="HouseTemplateDefinition" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/world/building/HouseTemplateDefinition.gd" id="1_house"]

[resource]
script = ExtResource("1_house")
id = "barracks"
display_name = "Kaserne"
description = "5×3 Felder Steinbau mit Bogentür und zwei Bogenfenstern, Steindach: Waffenständer an der Rückwand, Tisch mit Bank, Holzstapel und Fass. Draußen zwei Fahnen und Eisenlaternen am Eingang. Größerer Bruder des Wachpostens."
