[gd_resource type="Resource" script_class="HouseTemplateDefinition" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/world/building/HouseTemplateDefinition.gd" id="1_house"]

[resource]
script = ExtResource("1_house")
id = "wall_walk"
display_name = "Mauer mit Wehrgang"
description = "6 Felder Steinmauer mit Wehrgang: Zinnen-Brüstung außen, begehbarer Gang (2 m breit) auf der Mauerkrone, Holzgeländer innen und eine Steintreppe in der Westecke. In Reihe stellbar; die Treppe nur am Anfang nötig."
