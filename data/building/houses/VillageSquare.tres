[gd_resource type="Resource" script_class="HouseTemplateDefinition" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/world/building/HouseTemplateDefinition.gd" id="1_house"]

[resource]
script = ExtResource("1_house")
id = "village_square"
display_name = "Dorfplatz"
description = "5×5 Felder: gepflasterte Mitte mit Brunnen, vier Bänken und vier Laternen; links und rechts je zwei Marktstände, oben Kisten, Säcke und eine Fahne, unten Handkarren, Tisch und Feuerstelle. Mitte anvisieren und dort stehen."
