[gd_resource type="Resource" script_class="HouseTemplateDefinition" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/world/building/HouseTemplateDefinition.gd" id="1_house"]

[resource]
script = ExtResource("1_house")
id = "tavern"
display_name = "Taverne"
description = "4×3 Felder, Holz, Tür und Fenster, Holzdach. Ein Tresenzaun trennt drei Fässer vom Gastraum, Fässer dienen als Tische, an der Ostwand Ausschank und Ofen als Kamin. Draußen Wegweiser und Laterne."
